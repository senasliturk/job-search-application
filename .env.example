# =====================================================================
# Shared environment variables for local development (docker-compose)
# Copy to .env and fill in real values. NEVER commit .env.
# =====================================================================

# ---------- Firebase (IAM) ----------
# Public, safe to expose (used by frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=replace-me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=1:0000:web:abcd

# Server-side admin SDK – service-account JSON path inside container.
# In production set GOOGLE_APPLICATION_CREDENTIALS to the mounted path
# OR set FIREBASE_SERVICE_ACCOUNT_JSON to the raw JSON string.
FIREBASE_PROJECT_ID=your-project
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-sa.json

# ---------- Azure SQL (Job Postings) ----------
# Format: mssql+pyodbc://user:pwd@server.database.windows.net:1433/db?driver=ODBC+Driver+18+for+SQL+Server
JOB_POSTING_DB_URL=mssql+pyodbc://sa:Your_password123@db:1433/jobpostings?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ---------- Cosmos DB (Job Searches – NoSQL) ----------
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=replace-me
COSMOS_DATABASE=jobsearch
COSMOS_CONTAINER_SEARCHES=user_searches
COSMOS_CONTAINER_ALERTS=user_alerts

# ---------- Redis (Job Posting cache) ----------
REDIS_URL=redis://redis:6379/0
REDIS_TTL_SECONDS=300

# ---------- Azure Service Bus (Queue) ----------
# For local dev we fall back to RabbitMQ if SERVICE_BUS_CONNECTION_STRING is empty.
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_QUEUE_NEW_JOBS=new-job-postings
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ---------- AI Agent ----------
# Any OpenAI-compatible endpoint works (Anthropic, Azure OpenAI, OpenAI, etc.)
LLM_PROVIDER=openai
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ---------- Internal service URLs (used by API Gateway) ----------
JOB_POSTING_SERVICE_URL=http://job-posting-service:8001
JOB_SEARCH_SERVICE_URL=http://job-search-service:8002
NOTIFICATION_SERVICE_URL=http://notification-service:8003
AI_AGENT_SERVICE_URL=http://ai-agent-service:8004

# ---------- Notification scheduler key ----------
INTERNAL_API_KEY=change-me-to-a-long-random-string

# ---------- SMTP e-posta (opsiyonel — boş bırakılırsa sadece log yazar) ----------
# Ücretsiz seçenekler: Resend (resend.com), Mailgun free tier, Gmail App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------- Frontend ----------
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000
