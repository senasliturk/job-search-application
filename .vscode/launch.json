{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: API Gateway (8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/services/api-gateway",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "FastAPI: Job Posting (8001)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8001"],
      "cwd": "${workspaceFolder}/services/job-posting-service",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "FastAPI: Job Search (8002)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8002"],
      "cwd": "${workspaceFolder}/services/job-search-service",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "FastAPI: Notification (8003)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8003"],
      "cwd": "${workspaceFolder}/services/notification-service",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "FastAPI: AI Agent (8004)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8004"],
      "cwd": "${workspaceFolder}/services/ai-agent-service",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Next.js: Frontend (3000)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "ALL: backend + frontend",
      "configurations": [
        "FastAPI: Job Posting (8001)",
        "FastAPI: Job Search (8002)",
        "FastAPI: Notification (8003)",
        "FastAPI: AI Agent (8004)",
        "FastAPI: API Gateway (8000)",
        "Next.js: Frontend (3000)"
      ],
      "stopAll": true
    }
  ]
}
